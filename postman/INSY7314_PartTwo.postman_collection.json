      "name": "Authentication - Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registration successful or already exists\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Jane Freelancer\",\n  \"email\": \"jane@testing.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"freelancer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
